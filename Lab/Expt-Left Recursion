#include <stdio.h>
#include <string.h>

int main()
{
    char lhs;
    char alpha[50], beta[50];

    printf("Enter the Left Hand Side (Example: A): ");
    scanf(" %c", &lhs);

    printf("Enter alpha (left recursive part): ");
    scanf("%s", alpha);

    printf("Enter beta (non-left recursive part): ");
    scanf("%s", beta);

    printf("\nGrammar Before Removing Left Recursion:\n");
    printf("%c -> %c%s | %s\n", lhs, lhs, alpha, beta);

    printf("\nGrammar After Removing Left Recursion:\n");
    printf("%c -> %s%c'\n", lhs, beta, lhs);
    printf("%c' -> %s%c' | ε\n", lhs, alpha, lhs);

    return 0;
} 
