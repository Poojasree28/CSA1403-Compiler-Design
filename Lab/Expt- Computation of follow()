#include <stdio.h>
#include <string.h>
#include <ctype.h>

char production[20][20];
char follow[26][20];

int n;

void addFollow(char nonTerminal, char symbol)
{
    int i;
    int index = nonTerminal - 'A';

    for(i = 0; follow[index][i] != '\0'; i++)
    {
        if(follow[index][i] == symbol)
            return;
    }

    follow[index][i] = symbol;
    follow[index][i+1] = '\0';
}


void findFollow(char c)
{
    int i,j,k;

    for(i=0;i<n;i++)
    {
        for(j=2; production[i][j]!='\0'; j++)
        {
            if(production[i][j] == c)
            {
                // If there is a symbol after c
                if(production[i][j+1] != '\0')
                {
                    char next = production[i][j+1];

                    // If next symbol is terminal
                    if(!isupper(next))
                    {
                        addFollow(c,next);
                    }

                    // If next symbol is non-terminal
                    else
                    {
                        // Find FIRST(next)
                        for(k=2; k<20 && production[k][0]!='\0'; k++)
                        {
                            if(production[k][0] == next)
                            {
                                if(!isupper(production[k][2]))
                                {
                                    addFollow(c,production[k][2]);
                                }
                            }
                        }
                    }
                }

                // If c is at the end of production
                else
                {
                    if(production[i][0] != c)
                    {
                        findFollow(production[i][0]);

                        int x;
                        for(x=0; follow[production[i][0]-'A'][x]!='\0'; x++)
                        {
                            addFollow(c,follow[production[i][0]-'A'][x]);
                        }
                    }
                }
            }
        }
    }
}


int main()
{
    int i;

    printf("Enter number of productions: ");
    scanf("%d",&n);

    printf("Enter productions:\n");

    for(i=0;i<n;i++)
    {
        scanf("%s",production[i]);
    }


    for(i=0;i<26;i++)
    {
        follow[i][0]='\0';
    }


    // Start symbol gets $
    addFollow(production[0][0],'$');


    for(i=0;i<n;i++)
    {
        findFollow(production[i][0]);
    }


    printf("\nFOLLOW Sets:\n");

    for(i=0;i<n;i++)
    {
        printf("FOLLOW(%c) = { ",production[i][0]);

        int j;
        for(j=0;follow[production[i][0]-'A'][j]!='\0';j++)
        {
            printf("%c ",follow[production[i][0]-'A'][j]);
        }

        printf("}\n");
    }

    return 0;
}
